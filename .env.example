# =====================================================================
# Sentinel AI Network Intrusion Detection & Secure Chat Environment
# Copy this file to .env and configure machine-specific values.
# NEVER commit real credentials, tokens, or private keys to Git.
# =====================================================================

# Server Binding
HOST=0.0.0.0
PORT=8001

# Administrative Access Security
# REQUIRED: Set a strong, unique secret token for administrative operations (e.g. unblocking users).
# If unset or empty, administrative endpoints will reject requests with 403 Forbidden.
# .\setup.ps1 will generate a cryptographically secure token automatically on first run.
ADMIN_TOKEN=

# Optional HTTP telemetry database shared with the separate collector process.
# HTTP_TELEMETRY_DB=data/http-telemetry.sqlite3
# HTTP_STAGING_POLICY_KEYS={}
# HTTP_PRODUCTION_POLICY_KEYS={}
# HTTP_POLICY_PUBLIC_HOST=
# HTTP_POLICY_ALLOW_PRODUCTION=false

# Network Packet Capture & Adapter Selection
# Leave blank for AUTOMATIC adapter discovery (detects the active default LAN Wi-Fi/Ethernet adapter).
# Override only for manual debugging with a specific interface name or NPF device string:
# Example: NETWORK_INTERFACE=\Device\NPF_{17AED3A9-905E-440B-8E34-9A930904ABE0}
NETWORK_INTERFACE=
NETWORK_CAPTURE_FILTER=ip and (tcp or udp)

# Flow Tracking & Aggregation Timeouts (seconds)
FLOW_IDLE_TIMEOUT=15.0
FLOW_MAX_DURATION=120.0
GATV2_INFERENCE_WINDOW_SECONDS=5.0

# Network Intrusion Detection & Firewall Quarantine
# Automatic network quarantine is disabled by default for safety on development/demo laptops.
# Set to 'true' to allow GATv2 ATTACK predictions to create inbound Windows Defender Firewall block rules.
# Requires Administrator privileges when enabled.
NETWORK_AUTO_QUARANTINE=false

# Protected IP Addresses
# Comma-separated list of administrative or internal IP addresses that must NEVER be quarantined.
# Localhost (127.0.0.1, ::1), host adapter IPs, and default gateway routers are protected automatically.
ADMIN_IPS=
PROTECTED_IPS=

# Cloudflare Named Tunnel (Optional - for Public Internet Access)
# Set your named Cloudflare Tunnel token here to enable public attendance over HTTPS/WSS.
# Never commit real tunnel tokens or private credentials to Git.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_PUBLIC_HOSTNAME=
# No token/domain is needed for an explicitly enabled temporary Quick Tunnel.
# Set quick for trycloudflare.com, named with a token, or disabled.
CLOUDFLARE_TUNNEL_MODE=disabled

# Isolated real-socket HTTP flood demo. Local token controls remain available.
# Remote controls require opt-in, the configured HTTPS Cloudflare hostname,
# a trusted proxy boundary, and ADMIN_TOKEN authentication.
# Leave blank to use http://127.0.0.1:<actual ASGI listener port>.
# Only numeric loopback HTTP origins with explicit ports are accepted.
HTTP_FLOOD_BASE_URL=
HTTP_FLOOD_WINDOW_SECONDS=2
HTTP_FLOOD_WARNING_RPS=5
HTTP_FLOOD_BLOCK_RPS=12
HTTP_FLOOD_BLOCK_SECONDS=10

# Enable only after configuring CLOUDFLARE_PUBLIC_HOSTNAME and ADMIN_TOKEN.
HTTP_FLOOD_REMOTE_ENABLED=false
DASHBOARD_REMOTE_ENABLED=false
SENTINEL_CHAT_ONLY_TUNNEL=false
HTTP_POLICY_REMOTE_VERIFY_ENABLED=false
# The raw peer must remain visible: start Uvicorn with --no-proxy-headers.
# Loopback cloudflared is trusted by default. Add exact proxy IPs only if needed.
TRUSTED_PROXIES=

